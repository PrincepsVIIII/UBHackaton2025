# syntax=docker/dockerfile:1

# Backend image for Buffalo Winter Elder Help Routing (FastAPI + SQLite).
FROM python:3.11-slim AS backend

# Avoid Python writing .pyc files and enable unbuffered logs.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system packages required for building Python deps (if any).
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency file first to leverage Docker layer caching.
COPY ../backend/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy the backend source.
COPY ../backend ./backend

# Switch into backend project directory for runtime.
WORKDIR /app/backend

# Expose FastAPI default port.
EXPOSE 8000

# NOTE: Update GOOGLE_CLIENT_ID / APP_BASE_URL in ../.env before building for non-local deployments.

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

